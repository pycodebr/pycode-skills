# Cabeçalhos para Netlify e Cloudflare Pages (este arquivo vai na raiz publicada, ao lado do index.html).
# CSS, JS e fontes têm o hash do conteúdo no nome (gerado pelo `pycode page build`): podem ficar em cache por um ano.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=2592000
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
